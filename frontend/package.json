{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/clean-next-cache.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev:clean": "rm -rf .next && rm -f tsconfig.tsbuildinfo",
    "dev": "npm run doctor && NEXT_TELEMETRY_DISABLED=1 WATCHPACK_POLLING=true WATCHPACK_POLLING_INTERVAL=1000 next dev --webpack -H 0.0.0.0 -p 3001",
    "dev:unlock": "rm -rf .next/dev",
    "dev:3000": "NEXT_TELEMETRY_DISABLED=1 next dev --webpack -H :: -p 3000",
    "build": "rm -f tsconfig.tsbuildinfo && next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx"
  },
  "dependencies": {
    "browserslist": "^4.28.2",
    "caniuse-lite": "^1.0.30001791",
    "framer-motion": "^12.38.0",
    "jsx-ast-utils": "^3.3.5",
    "next": "^16.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "styled-jsx": "5.1.7",
    "tldraw": "^4.5.10",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.2.4",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
