# App
APP_NAME=Eko
APP_VERSION=v1.2
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_STATIC_DIR=../frontend

# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=39.104.87.235
POSTGRES_PORT=5432
POSTGRES_DB=nexus_pilot

# Redis
REDIS_HOST=39.104.87.235
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_QUEUE=aippt

# JWT
SECRET_KEY=nexus-pilot-secret-key-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ISSUER=eko-auth

# CORS
CORS_ORIGINS=["http://localhost:3000","http://<YOUR_SERVER_IP>:3000"]

# Feishu
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_VERIFICATION_TOKEN=your_verification_token
FEISHU_ENCRYPT_KEY=your_encrypt_key
FEISHU_WS_AUTO_START=false
FEISHU_WS_POLL_CHAT_IDS=
FEISHU_WS_POLL_INTERVAL_SECONDS=5
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_AUTH_BASE_URL=https://accounts.feishu.cn
FEISHU_OAUTH_REDIRECT_URI=http://127.0.0.1:3002/login/feishu/callback
FEISHU_OAUTH_SCOPE=contact:user.base:readonly search:docs:read
FEISHU_OAUTH_STATE_TTL_SECONDS=600
FRONTEND_LOGIN_SUCCESS_URL=http://127.0.0.1:3002/home
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_BITABLE_FIELD_TITLE=标题
FEISHU_BITABLE_FIELD_URL=文档链接
BITABLE_ENABLED=true
BITABLE_DEFAULT_WORKSPACE_ID=Feishu_demo_Eko
BITABLE_QUERY_LIMIT=8
BITABLE_ARCHIVE_ENABLED=false
BITABLE_PRESET_BASE_NAME=团队预置多维表格

# Agent
AGENT_MODEL=deepseek-v4-flash
AGENT_API_BASE=https://api.deepseek.com
AGENT_API_KEY=your_agent_api_key
AGENT_THINKING_ENABLED=false
AGENT_EMBEDDING_MODEL=Qwen3-Embedding-8B
AGENT_EMBEDDING_API_BASE=https://ai.gitee.com/v1
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_FAILOVER_ENABLED=true
RAG_EMBEDDING_DIMENSIONS=1024
RAG_CHUNK_SIZE=450
RAG_CHUNK_OVERLAP=80
VOLCENGINE_API_KEY=your_volcengine_api_key
VOLCENGINE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_MODEL=ep-your-endpoint-id

# AI PPT
AIPPT_MODEL=deepseek-v4-flash
AIPPT_API_BASE=https://api.deepseek.com
AIPPT_API_KEY=
AIPPT_STORAGE_DIR=storage/aippt
AIPPT_VENDOR_DIR=vendor/ppt-master
AIPPT_REDIS_QUEUE_ENABLED=true
AIPPT_UPLOADS_DIR=storage/aippt/uploads
AIPPT_PROJECTS_DIR=storage/aippt/projects
AIPPT_EXPORTS_DIR=storage/aippt/exports
AIPPT_MAX_UPLOAD_MB=25
AIPPT_SLIDE_CONCURRENCY=2
AIPPT_THINKING_ENABLED=false
AIPPT_IMAGE_GENERATION_ENABLED=false
AIPPT_IMAGE_API_BASE=https://www.packyapi.com
AIPPT_IMAGE_API_KEY=
AIPPT_IMAGE_MODEL=gpt-image-2
AIPPT_IMAGE_SIZE=3840x2160
AIPPT_IMAGE_QUALITY=high
AIPPT_IMAGE_OUTPUT_FORMAT=png
AIPPT_IMAGE_TIMEOUT_SECONDS=180
