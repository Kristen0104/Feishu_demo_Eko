# App
APP_NAME=Eko
APP_VERSION=v1.2
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_STATIC_DIR=../frontend

# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=39.104.87.235
POSTGRES_PORT=5432
POSTGRES_DB=nexus_pilot

# Redis
REDIS_HOST=39.104.87.235
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
SECRET_KEY=nexus-pilot-secret-key-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_ISSUER=eko-auth

# CORS
CORS_ORIGINS=["http://localhost:3000","http://39.104.87.235:3000"]

# Feishu
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_VERIFICATION_TOKEN=your_verification_token
FEISHU_ENCRYPT_KEY=your_encrypt_key
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_AUTH_BASE_URL=https://accounts.feishu.cn
FEISHU_OAUTH_REDIRECT_URI=http://127.0.0.1:8010/frontend/test.html
FEISHU_OAUTH_SCOPE=contact:user.base:readonly
FEISHU_OAUTH_STATE_TTL_SECONDS=600
FRONTEND_LOGIN_SUCCESS_URL=http://127.0.0.1:8010/frontend/test.html

# Agent
AGENT_MODEL=deepseek-v4-flash
AGENT_API_BASE=https://api.deepseek.com
AGENT_API_KEY=your_agent_api_key
AGENT_EMBEDDING_MODEL=text-embedding-3-small

# PPT
PPT_USE_LIVE_LLM=false
PPT_LLM_TIMEOUT_SECONDS=180
PPT_LLM_MAX_TOKENS=16000
PPT_EXPORT_NODE_BIN=node
PPT_EXPORT_NODE_MODULES=
PPT_EXPORT_VIEWPORT_WIDTH=1600
PPT_EXPORT_VIEWPORT_HEIGHT=900
PPT_EXPORT_DEVICE_SCALE_FACTOR=2
